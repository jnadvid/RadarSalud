# RadarSalud - Variables de entorno (copiar a .env y rellenar)
# -----------------------------------------------------------------
# Ninguna clave es obligatoria para arrancar el MVP. Los conectores
# que requieren clave quedan desactivados y documentados si falta.

# Base de datos (por defecto SQLite local)
RADARSALUD_DATABASE_URL=sqlite:///data/radarsalud.sqlite

# Servidor
RADARSALUD_HOST=127.0.0.1
RADARSALUD_PORT=8000
RADARSALUD_DEBUG=false

# AEMET OpenData (https://opendata.aemet.es/) - requiere API key gratuita
# Si está vacío, el conector AEMET queda desactivado pero documentado.
AEMET_API_KEY=

# datos.gob.es - API pública abierta, no requiere clave
DATOS_GOB_BASE_URL=https://datos.gob.es/apidata

# Límite de red / cortesía (segundos entre peticiones a la misma fuente)
RADARSALUD_HTTP_TIMEOUT=30
RADARSALUD_HTTP_RATE_LIMIT_SECONDS=1.0
RADARSALUD_USER_AGENT=RadarSalud/0.1 (+https://github.com/jnadvid/radarsalud) open-data research

# Nivel de log: DEBUG, INFO, WARNING, ERROR
RADARSALUD_LOG_LEVEL=INFO
